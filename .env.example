# Copy to .env and fill in every empty value (or run ./start-infrastructure.sh,
# which generates a .env with random values). .env is git-ignored. Compose
# refuses to start while any required value is empty.
# Generate a value with: openssl rand -base64 24 | tr -d '/+='

POSTGRES_PASSWORD=
REDIS_PASSWORD=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Imported into the coghealth realm (docker/keycloak/coghealth-realm.json)
KC_REALM_ADMIN_PASSWORD=
KC_DEMO_USER_PASSWORD=
KC_API_CLIENT_SECRET=

RABBITMQ_USER=coghealth
RABBITMQ_PASSWORD=

# Elasticsearch `elastic` superuser, and the kibana_system user Kibana logs in as
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
