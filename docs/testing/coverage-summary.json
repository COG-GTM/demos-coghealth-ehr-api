        "PatientServiceTest#brSvc01_patientAccessMethodsAreAudited",
        "PatientServiceTest#brSvc01_lookupReturnsMappedDto"
      ],
      "status": "covered"
    },
    {
      "id": "BR-SVC-02",
      "module": "service",
